{
  "name": "discordkit",
  "description": "A REST API Client for Discord",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0",
    "@next/env": "npm:@varlock/nextjs-integration@^1.2.0"
  },
  "type": "module",
  "scripts": {
    "format": "vp run lint --fix",
    "test": "vp test --fileParallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@trpc/server": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "^21.0.4",
    "msw": "catalog:",
    "nodejs-snowflake": "^2.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "^6.1.4",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "valimock": "1.7.1",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@saeris/configs": "1.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vite-plus": "catalog:"
  }
}
