{
  "extends": "@saeris/configs/tsconfig",
  "include": ["./**/*.{j,t}s?(x)", "./**/*.spec.ts"],
  "exclude": [
    "node_modules",
    ".yarn",
    ".claude",
    "./**/.next/**/*.*",
    "./**/dist",
    // The Cloudflare example needs Workers types instead of Node's, and
    // declares them in its own tsconfig. Without this exclusion the root
    // `include` glob also claims those files, so editors can bind them to this
    // config — where `cloudflare:workers`/`cloudflare:test` (virtual modules,
    // not packages) don't resolve. `vp check` reads the nearest tsconfig and is
    // unaffected, which is why it passes while the editor reports errors.
    "./examples/with-cloudflare"
  ],
  "compilerOptions": {
    // Add DOM on top of the base's ESNext lib for verifyKey's
    // window/crypto feature-detection and any other client-runtime checks.
    "lib": ["ESNext", "DOM"],
    // Resolve workspace imports through each package's private
    // `@discordkit/source` export condition during local dev. Lets `tsc` and
    // tooling read src/*.ts directly without requiring `dist/` to exist. The
    // name is intentionally private (not the standard `development`) so that
    // external consumers — notably Next.js bundlers — don't pick it up and try
    // to resolve our `.js`-on-`.ts` source imports, which they can't.
    "customConditions": ["@discordkit/source"],
    // Library-shape: pull TS runtime helpers from `tslib` instead of
    // inlining them into every emitted module. Smaller dist/ output.
    "importHelpers": true,
    // `scripts/` runs under `node --experimental-strip-types`, which resolves
    // the literal specifier and so needs real `.ts` extensions — it does no
    // `.js`->`.ts` remapping. Those scripts import each other that way already;
    // this makes the same specifiers legal to a spec that imports one. Safe
    // because the base config sets `noEmit` (the option's only requirement) and
    // package builds emit through tsdown, not tsc.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
